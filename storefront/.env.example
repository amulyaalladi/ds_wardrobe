# Copy to .env.local (never commit it)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Admin > Settings > Publishable API Keys (link your sales channel to it)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Country code + number, digits only (used for WhatsApp ordering links)
NEXT_PUBLIC_WHATSAPP_NUMBER=917032932549
# Razorpay KEY ID only (rzp_test_... in test mode). Never put the key secret here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
